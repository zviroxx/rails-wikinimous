<div class="container mt-3">
  <div class="row">
    <div class="col-sm-8 offset-sm-2">
      <article>
        <h1><%= @article.title %> <small><%= link_to "<i class=\"fa-solid fa-pencil\"></i>".html_safe, edit_article_path(@article)%> <%= link_to "<i class=\"fa-solid fa-trash-can\"></i>".html_safe, article_path(@article), data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}%></small></h1>
        <hr>
        <p><%= @article.content %>
        </p>
      </article>
    </div>
  </div>
</div>
